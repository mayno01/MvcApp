@model List<MvcApp.Models.News.NewsArticle>

@{
    ViewData["Title"] = "News";
}

<div class="container mt-4">

    <div class="mb-4">
        <a asp-action="Index" asp-route-category="general" class="btn btn-outline-primary me-2">General</a>
        <a asp-action="Index" asp-route-category="business" class="btn btn-outline-primary me-2">Business</a>
        <a asp-action="Index" asp-route-category="technology" class="btn btn-outline-primary me-2">Technology</a>
        <a asp-action="Index" asp-route-category="sports" class="btn btn-outline-primary me-2">Sports</a>
        <a asp-action="Index" asp-route-category="health" class="btn btn-outline-primary me-2">Health</a>
        <a asp-action="Index" asp-route-category="science" class="btn btn-outline-primary me-2">Science</a>
        <a asp-action="Index" asp-route-category="entertainment" class="btn btn-outline-primary">Entertainment</a>
    </div>


    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Latest News</h2>

        <form asp-controller="Auth" asp-action="Logout" method="get">
            <button class="btn btn-danger">Logout</button>
        </form>
    </div>

    <div class="row">
        @foreach (var news in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(news.UrlToImage))
                    {
                        <img src="@news.UrlToImage" class="card-img-top" style="height: 200px; object-fit: cover;">
                    }
                    <div class="card-body">
                        <h5 class="card-title">@news.Title</h5>
                        <p class="card-text">@news.Description</p>
                    </div>
                    <div class="card-footer bg-white">

                        <small class="text-muted">@news.Source • @news.PublishedAt.ToShortDateString()</small>

                        <div class="float-end d-flex gap-2">
                            <button class="btn btn-sm btn-outline-info speak-btn"
                                    data-title="@news.Title"
                                    data-desc="@news.Description">
                                🔊 Read
                            </button>

                            <a href="@news.Url" target="_blank"
                               class="btn btn-sm btn-outline-primary">
                                Read
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>

</div>
@section Scripts {
    <script>
        document.querySelectorAll(".speak-btn").forEach(button => {
            button.addEventListener("click", () => {
                const title = button.getAttribute("data-title");
                const desc = button.getAttribute("data-desc");

                const msg = new SpeechSynthesisUtterance();
                msg.text = `${title}. ${desc}`;
                msg.lang = "en-US"; 

                window.speechSynthesis.speak(msg);
            });
        });
    </script>
}
