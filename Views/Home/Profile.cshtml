@model MvcApp.Models.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Profile";
}

<div class="container vh-100 d-flex justify-content-center align-items-center">
    <div class="card shadow-lg p-4" style="width: 480px; border-radius: 15px;">

        <h3 class="text-center mb-4 fw-bold">User Profile</h3>

        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success text-center">
                @ViewBag.Success
            </div>
        }

        <form method="post" enctype="multipart/form-data">

            <div class="text-center mb-3">
                @if (Model.ProfileImageBase64 != null)
                {
                    <img src="data:image/png;base64,@Model.ProfileImageBase64"
                         class="rounded-circle"
                         width="120" height="120" />
                }
                else
                {
                    <img src="https://via.placeholder.com/120"
                         class="rounded-circle" />
                }
            </div>

            <div class="mb-3">
                <label class="form-label">Profile Picture</label>
                <input asp-for="ProfileImage" type="file" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Username</label>
                <input asp-for="Username" class="form-control" />
            </div>

            <hr />

            <div class="mb-3">
                <label>New Password</label>
                <input asp-for="NewPassword" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control" />
            </div>

            <button class="btn btn-primary w-100">Save</button>
        </form>


        <hr class="my-3" />

        <div class="text-center">
            <a asp-action="Index" class="text-decoration-none">Back to Home</a>
        </div>

    </div>
</div>
