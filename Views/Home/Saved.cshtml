@model List<MvcApp.Models.UserArticleInteraction>

@{
    ViewData["Title"] = "Saved Articles";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">
            ← Back to Home
        </a>

        <h2 class="mb-0">Saved Articles</h2>
    </div>

    @if (!Model.Any())
    {
        <p>You have no saved articles.</p>
    }
    else
    {
        <div class="row">
            @foreach (var saved in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">

                        @if (!string.IsNullOrEmpty(saved.ImageUrl))
                        {
                            <img src="@saved.ImageUrl"
                                 class="card-img-top"
                                 style="height:200px; object-fit:cover;" />
                        }

                        <div class="card-body">
                            <h5 class="card-title">@saved.Title</h5>
                            <span class="badge bg-secondary">@saved.Category</span>
                        </div>

                        <div class="card-footer bg-white border-0">
                            <a href="@saved.ArticleUrl"
                               target="_blank"
                               class="btn btn-sm btn-primary w-100">
                                Read Article →
                            </a>
                        </div>

                    </div>
                </div>
            }
  
        </div>
    }
</div>
<script>
    document.addEventListener("keydown", e => {
     if (e.key === "Escape") {
     window.location.href = "/Home/Index";
     }
     });
</script>